<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">
    <fragment
    android:id="@+id/homeFragment"
    android:name="com.example.musicapp.presentation.home.HomeFragment"
    android:label="Home"
    tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.musicapp.presentation.splash.SplashFragment"
        android:label="fragment_splash"
        tools:layout="@layout/fragment_splash" >
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.musicapp.presentation.auth.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.musicapp.presentation.auth.SignUpFragment"
        android:label="SignUpFragment" />
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.musicapp.presentation.profile.ProfileFragment"
        android:label="ProfileFragment" >
        <action
            android:id="@+id/action_profileFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.example.musicapp.presentation.library.LibraryFragment"
        android:label="LibraryFragment" >
        <action
            android:id="@+id/action_libraryFragment_to_favoriteFragment"
            app:destination="@id/favoriteFragment" />
        <action
            android:id="@+id/action_libraryFragment_to_playListFragment"
            app:destination="@id/playListFragment" />

    </fragment>
    <fragment
        android:id="@+id/favoriteFragment"
        android:name="com.example.musicapp.presentation.favorite.FavoriteFragment"
        android:label="FavoriteFragment" />
    <fragment
        android:id="@+id/playListFragment"
        android:name="com.example.musicapp.presentation.playlist.PlayListFragment"
        android:label="PlayListFragment">
        <argument
            android:name="playlistId"
            app:argType="long" />

        <argument
            android:name="playlistName"
            app:argType="string" />

        <argument
            android:name="playlistImageUrl"
            app:argType="string" />

    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.musicapp.presentation.search.SearchFragment"
        android:label="SearchFragment" />


</navigation>